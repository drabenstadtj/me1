tracks/0/keys = {
"times": PackedFloat32Array(0.233333, 14.6333, 21.1667, 28.0333),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"values": [{
"args": ["Unknown: You're not supposed to be here."],
"method": &"type_text"
}, {
"args": ["Unknown: This is how it works. One body suffers, the others continue. That’s the rule."],
"method": &"type_text"
}, {
"args": ["You can choose to take the pain yourself.Or copy yourself into a discard — and send that version in your place."],
"method": &"type_text"
}, {
"args": ["The discard will feel it. Just as real. Just as conscious.But you’ll stay safe."],
"method": &"type_text"
}]
}
