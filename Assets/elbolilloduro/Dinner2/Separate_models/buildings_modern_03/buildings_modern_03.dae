  <library_effects>
    <effect id="buildings_modern_03-effect">
      <profile_COMMON>
        <newparam sid="buildings_modern_03_jpg-surface">
          <surface type="2D">
            <init_from>buildings_modern_03_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="buildings_modern_03_jpg-sampler">
          <sampler2D>
            <source>buildings_modern_03_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="buildings_modern_03_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Rooftiles-effect">
      <profile_COMMON>
        <newparam sid="Rooftiles_png-surface">
          <surface type="2D">
            <init_from>Rooftiles_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Rooftiles_png-sampler">
          <sampler2D>
            <source>Rooftiles_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Rooftiles_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
