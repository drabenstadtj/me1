  <library_effects>
    <effect id="Tray_01-effect">
      <profile_COMMON>
        <newparam sid="Tray_01_png-surface">
          <surface type="2D">
            <init_from>Tray_01_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Tray_01_png-sampler">
          <sampler2D>
            <source>Tray_01_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Tray_01_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
